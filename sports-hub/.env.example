# Where sports-hub reaches Jellyfin (container network name or URL). Viewers' own tokens are forwarded to it.
JELLYFIN_URL=http://jellyfin:8096

# Which calendar day counts as "today" for schedules.
SPORTS_TIMEZONE=America/New_York

# Optional: channels named by call sign that carry a network, e.g. an antenna's local affiliates.
# CHANNEL_ALIASES=WFLD=FOX;WBBM=CBS;WMAQ=NBC;WLS=ABC
CHANNEL_ALIASES=

# Optional: identify yourself to ESPN's public API.
SPORTS_USER_AGENT=orbital-sports-hub/1.0
